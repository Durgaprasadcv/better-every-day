{
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "hosting": "bettereveryday-5317",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      ".git",
      "*.log",
      ".env*",
      "src",
      "tsconfig*.json",
      ".eslintrc.js"
    ],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run check"
    ]
  }
}
